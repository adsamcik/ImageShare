<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="imageshare.db" />
        <exclude domain="database" path="imageshare.db-shm" />
        <exclude domain="database" path="imageshare.db-wal" />
        <exclude domain="file" path="datastore/imageshare_uri_registry.preferences_pb" />
        <exclude domain="file" path="datastore/imageshare_presets.preferences_pb" />
        <exclude domain="file" path="cache" />
        <exclude domain="external" path="cache" />
